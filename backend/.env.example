HOST=0.0.0.0
PORT=5000

DB_HOST=localhost
DB_PORT=5434
DB_NAME=smart_rehab_db
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# IANA timezone used for dashboard day/week grouping (default: Asia/Riyadh)
APP_TIMEZONE=Asia/Hebron

# Azure Translator (Exercise content Arabic display)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=switzerlandnorth
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# Auth email links (frontend routes)
# VERIFY_EMAIL_URL=https://your-frontend.example/verify-email
# RESET_PASSWORD_URL=https://your-frontend.example/reset-password

# Email delivery — default is SMTP (local/dev).
# EMAIL_PROVIDER=smtp
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=gmail-api
EMAIL_FROM=

# Resend (HTTPS — set EMAIL_PROVIDER=resend)
# RESEND_API_KEY=

# Gmail API OAuth2 (HTTPS — set EMAIL_PROVIDER=gmail-api)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER=

# SMTP (local/dev — used when EMAIL_PROVIDER is unset or smtp)
# EMAIL_USER=
# EMAIL_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# Optional public logo URL for emails (skips CID attachment)
# EMAIL_LOGO_URL=

# Speech Analysis V3.1 — MFA forced phoneme alignment (English only)
# MFA_ENV_PATH=C:\mfa_env
# MFA_ACOUSTIC_MODEL=english_mfa
# MFA_DICTIONARY=english_us_mfa
# MFA_ALIGNMENT_TIMEOUT_MS=180000

# Speech Analysis V3.2.2 — isolated Parselmouth acoustic extraction (English target intervals)
# SPEECH_ACOUSTIC_PYTHON=C:\Projects\smart-rehabilitation-platform\python_services\acoustic_extraction\.venv\Scripts\python.exe
# SPEECH_ACOUSTIC_TIMEOUT_MS=15000

