# Backend API (required). Local default matches Vite + Express local setup.
# On Vercel, set this to the production API base URL (…/api/v1). Do not commit production URLs.
VITE_API_URL=http://localhost:5000/api/v1

# Firebase Web app config (required for web push / messaging init and for
# scripts/generate-sw.cjs during predev/prebuild).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional; used by the messaging service worker when provided.
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate (VAPID) public key — required to call getToken(...) for FCM.
VITE_FIREBASE_VAPID_KEY=

# Optional. Allowed values: Asia/Hebron, Asia/Riyadh, Asia/Dubai, Asia/Kuwait,
# Asia/Bahrain, Asia/Qatar, Asia/Muscat, UTC. Defaults to Asia/Hebron when unset/invalid.
VITE_APP_TIMEZONE=Asia/Hebron
